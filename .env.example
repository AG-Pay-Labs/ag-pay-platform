ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://agpay:agpay_postgres_dev@localhost:5432/agpay
REDIS_URL=redis://:agpay_redis_dev@localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
# Development-only key. Generate a different one with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=5kcij8G9Y0ByB6hjw8eKg5wp2KAadM-qEpEq-20_HFg=
ACCESS_TOKEN_EXPIRE_MINUTES=30
AGENT_TOKEN_EXPIRE_DAYS=365
PAIRING_TOKEN_EXPIRE_MINUTES=15
AGENT_ONLINE_WINDOW_SECONDS=120
CHECKOUT_ENABLED=false
# Development/test-only Stripe Payments fixtures. Hosted mode installs the pinned
# keyless `stripe-hosted` adapter and requires CHECKOUT_DEMO_ENABLED; never enable
# either outside development/test.
CHECKOUT_DEMO_ENABLED=false
CHECKOUT_HOSTED_DEMO_ENABLED=false
# Used only by the older local demo-merchant adapter, not by `stripe-hosted`.
CHECKOUT_DEMO_ADAPTER_KEY=stripe-demo
CHECKOUT_WORKER_POLL_SECONDS=1
CHECKOUT_LEASE_SECONDS=120
CHECKOUT_MAX_ATTEMPTS=3
CHECKOUT_RESULT_TIMEOUT_SECONDS=60
CHECKOUT_AUTHORIZATION_TIMEOUT_SECONDS=30
CHECKOUT_AUTHORIZATION_POLL_SECONDS=1
# Optional direct demo-merchant observation delay; the hosted rail ignores it.
CHECKOUT_DEMO_OBSERVATION_SECONDS=30
# Development/test-only Stripe Link Wallet for Agents prototype. It always provisions
# a Stripe test virtual card; both flags must be true.
STRIPE_LINK_ENABLED=false
STRIPE_LINK_TEST_MODE=false
# JSON mapping of operator-owned merchant adapters. Never source selectors from an agent request.
# Configured adapters identify payment fields; browserbase_ai direct adapters omit payment/submit
# selectors and retain operator-owned product, quantity, total, origin, and result definitions.
CHECKOUT_ADAPTERS={}
# Local research-only direct-card rail. The API stores only encrypted PAN; CVC is
# supplied during approval and is consumed once from worker memory. Generate a
# dedicated Fernet key with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Generate the broker token separately with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
LOCAL_DIRECT_CARD_ENABLED=false
DIRECT_CARD_ENCRYPTION_KEY=
LOCAL_DIRECT_CARD_SOCKET_PATH=/tmp/agpay-direct-card/cvc.sock
LOCAL_DIRECT_CARD_BROKER_TOKEN=
LOCAL_DIRECT_CARD_CVC_TTL_SECONDS=300
LOCAL_DIRECT_CARD_SOCKET_TIMEOUT_SECONDS=2
# Stagehand observe maps payment fields before any payment credential is loaded.
CHECKOUT_FORM_ANALYSIS_MODEL=google/gemini-2.5-flash
CHECKOUT_FORM_ANALYSIS_TIMEOUT_SECONDS=120
# Worker-only credentials. A shared .env is for local development; inject these only into the
# checkout-worker process in production so the FastAPI process never loads them.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=eu-central-1
BROWSERBASE_API_URL=https://api.browserbase.com/v1
STRIPE_SECRET_KEY=
# Required only by the older direct demo rail and legacy Stripe-API-backed test
# paths. The fixed-URL `stripe-hosted` rail must not use a merchant Stripe key.
STRIPE_DEMO_SECRET_KEY=
# Required only by `make demo-merchant-run`; leave empty for the hosted rail.
STRIPE_DEMO_PUBLISHABLE_KEY=
# Local demo-merchant catalog settings; ignored by the fixed-URL hosted rail.
DEMO_PRODUCT_TITLE=AG Pay Browserbase Demo
DEMO_AMOUNT_MINOR=2500
DEMO_CURRENCY=EUR
STRIPE_API_URL=https://api.stripe.com
# Link CLI is invoked only by the checkout worker. Each wallet OAuth session lives at
# STRIPE_LINK_AUTH_DIRECTORY/<AG Pay owner UUID>.json; keep the directory mode 0700.
STRIPE_LINK_CLI_PATH=link-cli
STRIPE_LINK_CLI_VERSION=0.12.0
STRIPE_LINK_AUTH_DIRECTORY=
STRIPE_LINK_APPROVAL_TIMEOUT_SECONDS=600
STRIPE_LINK_CLI_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:3000"]
