ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://agpay:agpay_postgres_dev@localhost:5432/agpay
REDIS_URL=redis://:agpay_redis_dev@localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
# Development-only key. Generate a different one with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=5kcij8G9Y0ByB6hjw8eKg5wp2KAadM-qEpEq-20_HFg=
ACCESS_TOKEN_EXPIRE_MINUTES=30
AGENT_TOKEN_EXPIRE_DAYS=365
PAIRING_TOKEN_EXPIRE_MINUTES=15
AGENT_ONLINE_WINDOW_SECONDS=120
CHECKOUT_ENABLED=false
# Development/test-only Stripe Payments fixtures. Hosted mode installs the pinned
# `stripe-hosted` adapter and requires CHECKOUT_DEMO_ENABLED; never enable either in production.
CHECKOUT_DEMO_ENABLED=false
CHECKOUT_HOSTED_DEMO_ENABLED=false
# Used only by the older local demo-merchant adapter, not by `stripe-hosted`.
CHECKOUT_DEMO_ADAPTER_KEY=stripe-demo
CHECKOUT_WORKER_POLL_SECONDS=1
CHECKOUT_LEASE_SECONDS=120
CHECKOUT_MAX_ATTEMPTS=3
CHECKOUT_RESULT_TIMEOUT_SECONDS=60
CHECKOUT_AUTHORIZATION_TIMEOUT_SECONDS=30
CHECKOUT_AUTHORIZATION_POLL_SECONDS=1
# Optional direct demo-merchant observation delay; the hosted rail ignores it.
CHECKOUT_DEMO_OBSERVATION_SECONDS=30
# JSON mapping of operator-owned merchant adapters. Never source selectors from an agent request.
# Every adapter must identify the approved product title, quantity, total, payment fields, and result.
CHECKOUT_ADAPTERS={}
# Worker-only credentials. A shared .env is for local development; inject these only into the
# checkout-worker process in production so the FastAPI process never loads them.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=eu-central-1
BROWSERBASE_API_URL=https://api.browserbase.com/v1
STRIPE_SECRET_KEY=
# Test-mode secret used by both demo rails. The hosted rail does not need a publishable key.
STRIPE_DEMO_SECRET_KEY=
# Required only by `make demo-merchant-run`; leave empty for the hosted rail.
STRIPE_DEMO_PUBLISHABLE_KEY=
# Local demo-merchant catalog settings; ignored by the hosted rail, whose product facts
# are copied from the approved AG Pay execution into a new Stripe test Checkout Session.
DEMO_PRODUCT_TITLE=AG Pay Browserbase Demo
DEMO_AMOUNT_MINOR=2500
DEMO_CURRENCY=EUR
STRIPE_API_URL=https://api.stripe.com
CORS_ORIGINS=["http://localhost:3000"]
